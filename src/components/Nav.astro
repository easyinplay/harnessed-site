---
import { t, locales, localeMeta, homeFor, docsFor } from '../i18n'
import type { Locale } from '../i18n'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const dict = t(lang)
const current = localeMeta[lang]
---

<header class="sticky top-9 z-40 h-16 bg-[#0A0A0F]/80 backdrop-blur-md border-b border-violet-400/10">
  <div class="max-w-6xl mx-auto px-6 h-full flex items-center justify-between">
    <a href={homeFor(lang)} class="flex items-center gap-2">
      <span class="font-semibold text-white">harnessed</span>
      <span class="bg-violet-400 size-1.5 rounded-full inline-block"></span>
    </a>
    <nav class="flex items-center gap-6">
      <a href={docsFor(lang)} class="text-sm text-zinc-400 hover:text-white transition-colors">{dict.nav.docs}</a>
      <a href="https://github.com/easyinplay/harnessed" class="hidden sm:inline text-sm text-zinc-400 hover:text-white transition-colors">{dict.nav.github}</a>
      <a href="https://www.npmjs.com/package/harnessed" class="hidden sm:inline text-sm text-zinc-400 hover:text-white transition-colors">{dict.nav.npm}</a>

      <div class="relative" data-lang-menu>
        <button
          type="button"
          class="flex items-center gap-1.5 text-sm text-zinc-400 hover:text-white transition-colors rounded-md px-2 py-1 border border-violet-400/10 hover:border-violet-400/30"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Language"
          data-lang-trigger
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"></path>
          </svg>
          <span>{current.short}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3" aria-hidden="true">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
        <ul
          class="hidden absolute right-0 top-full mt-2 min-w-44 rounded-lg border border-violet-400/15 bg-[#12121A] py-1.5 shadow-xl shadow-black/40 max-h-[70vh] overflow-y-auto"
          role="menu"
          data-lang-list
        >
          {
            locales.map((l) => (
              <li role="none">
                <a
                  role="menuitem"
                  href={homeFor(l)}
                  hreflang={localeMeta[l].htmlLang}
                  data-locale={l}
                  aria-current={l === lang ? 'true' : undefined}
                  class:list={[
                    'block px-3 py-1.5 text-sm transition-colors lang-switch',
                    l === lang ? 'text-white bg-violet-400/10' : 'text-zinc-400 hover:text-white hover:bg-violet-400/5',
                  ]}
                >
                  {localeMeta[l].label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  ;(function () {
    var root = document.querySelector('[data-lang-menu]')
    if (!root) return
    var trigger = root.querySelector('[data-lang-trigger]')
    var list = root.querySelector('[data-lang-list]')

    function close() {
      list.classList.add('hidden')
      trigger.setAttribute('aria-expanded', 'false')
    }

    trigger.addEventListener('click', function (e) {
      e.stopPropagation()
      var open = list.classList.toggle('hidden') === false
      trigger.setAttribute('aria-expanded', String(open))
    })

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) close()
    })
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close()
    })

    // Persist the manual pick so the auto-detect redirect stops overriding it.
    list.querySelectorAll('.lang-switch').forEach(function (el) {
      el.addEventListener('click', function () {
        var locale = el.getAttribute('data-locale')
        if (locale) {
          document.cookie =
            'harnessed_lang=' + locale + '; path=/; max-age=31536000; samesite=lax'
        }
      })
    })
  })()
</script>
